@model List<Staybnb.Models.Booking>
@{
    ViewData["Title"] = "Booking Requests";
}

<h1>Booking Requests</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <p>No booking requests yet.</p>
}
else
{
    <table class="table align-middle">
        <thead><tr><th>Guest</th><th>Property</th><th>Dates</th><th>Guests</th><th>Total</th><th>Payment</th><th>Status</th><th></th></tr></thead>
        <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td>@b.Guest.FirstName @b.Guest.LastName<br /><small class="text-muted">@b.Guest.Email</small></td>
                    <td>@b.Property.Title</td>
                    <td>@b.CheckInDate.ToString("yyyy-MM-dd") to @b.CheckOutDate.ToString("yyyy-MM-dd")</td>
                    <td>@b.NumberOfGuests</td>
                    <td>R @b.TotalPrice.ToString("N2")</td>
                    <td>@(b.Payment?.Status.ToString() ?? "-")</td>
                    <td>@b.Status</td>
                    <td>
                        @if (b.Status == Staybnb.Models.BookingStatus.Pending)
                        {
                            <form asp-action="ApproveBooking" asp-route-id="@b.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-success btn-sm">Approve</button>
                            </form>
                            <form asp-action="RejectBooking" asp-route-id="@b.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-danger btn-sm">Reject</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
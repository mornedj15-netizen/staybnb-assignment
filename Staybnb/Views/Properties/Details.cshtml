@model Staybnb.Models.HostProperty
@{
    ViewData["Title"] = Model.Title;
    var rating = Model.Reviews.Any() ? Model.Reviews.Average(r => r.Rating) : 0;
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<h1>@Model.Title</h1>
<p class="text-muted">@Model.Address, @Model.City · @Model.PropertyType · Up to @Model.MaxGuests guests · ★ @rating.ToString("0.0") (@Model.Reviews.Count reviews)</p>

<div class="row g-2 mb-4">
    @foreach (var img in Model.Images)
    {
        <div class="col-6 col-md-3">
            <img src="@img.ImageUrl" alt="@Model.Title" class="w-100" style="height:180px;object-fit:cover;border-radius:12px;" />
        </div>
    }
</div>

<div class="row">
    <div class="col-md-7">
        <p class="text-muted">Hosted by @Model.Host.FirstName @Model.Host.LastName</p>
        <p>@Model.Description</p>

        @if (Model.Amenities.Any())
        {
            <h4>Amenities</h4>
            <ul>@foreach (var a in Model.Amenities) {
                <li>@a.Name</li>
            }
        </ul>
    }

    <h4>Reviews</h4>
    @if (!Model.Reviews.Any())
    {
        <p class="text-muted">No reviews yet.</p>
    }
    @foreach (var r in Model.Reviews)
    {
        <div class="mb-2"><strong>@r.Reviewer.FirstName</strong> · ★ @r.Rating<br />@r.Comment</div>
    }
</div>

<div class="col-md-5">
    <div class="card p-3 shadow-sm">
        <h4>R @Model.PricePerNight.ToString("N0") <small class="text-muted">/ night</small></h4>

        @if (User.IsInRole("Guest"))
        {
            <form method="get" asp-controller="Booking" asp-action="Review">
                <input type="hidden" name="propertyId" value="@Model.Id" />
                <div class="mb-2">
                    <label class="form-label">Check-in</label>
                    <input type="date" name="checkIn" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="mb-2">
                    <label class="form-label">Check-out</label>
                    <input type="date" name="checkOut" class="form-control" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Guests</label>
                    <input type="number" name="guests" class="form-control" value="1" min="1" max="@Model.MaxGuests" required />
                </div>
                <button type="submit" class="btn btn-danger w-100">Check price</button>
            </form>
        }
        else if (User.Identity?.IsAuthenticated == true)
        {
            <p class="text-muted mb-0">Only Guest accounts can book.</p>
        }
        else
        {
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-danger w-100">Log in to book</a>
        }
    </div>
</div>
</div>